# Copy to .env for local use, or paste these into your host's environment
# variable settings. Never commit the filled-in version.

# --- required for a public deployment -------------------------------------
# The server refuses to start with NODE_ENV=production until this is set,
# because the default password is published in the README.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# The UPI ID every payment QR points at. Copy it exactly from your UPI app
# (Profile > UPI IDs). Get this wrong and customers pay the wrong account.
UPI_VPA=
UPI_PAYEE_NAME=Reji Fashions

# --- WhatsApp order alerts -------------------------------------------------
WHATSAPP_NUMBER=919074666413

# link | callmebot | cloud | twilio
WHATSAPP_PROVIDER=link

# callmebot: message "I allow callmebot to send me messages" to +34 644 51 95 23
CALLMEBOT_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TOKEN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- hosting ---------------------------------------------------------------
NODE_ENV=production
PORT=4173

# Point at a mounted persistent disk. Orders and uploaded photographs are
# written here; on an ephemeral filesystem they are lost on every restart.
DATA_DIR=/var/data

# Shown in the startup banner only.
PUBLIC_URL=
